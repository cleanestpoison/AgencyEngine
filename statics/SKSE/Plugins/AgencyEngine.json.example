// AgencyEngine.json.example — reference only. This file is never read.
//
// AgencyEngine ships NO config file on purpose. With no
// Data/SKSE/Plugins/AgencyEngine.json present, every setting is the one this
// version of the mod ships, and a later version that retunes a default reaches
// you. Shipping a filled-in file would freeze every default at whatever they
// happened to be on the day you installed, and every update after that would be
// fighting it.
//
// The real file is written for you on the first SkyUI MCM change, or when you
// press Save settings in SKSE Menu Framework. It holds ONLY the settings you
// changed. Anything absent from it stays live and follows the mod.
// That is why yours will be much shorter than this — this lists every key that
// exists, with the shipped value, so you can see what there is.
//
// Also: JSON has no comments. Copying this file to AgencyEngine.json will fail
// to parse. Change settings in-game instead.
{
  "enabled": true,
  "cues": true,
  "generateThought": false,
  "requireFollower": true,
  "skipInCombat": true,
  "forcedImpulseChance": 0,

  "maxEvents": 70,
  "perFollowerEvents": 10,
  "eventTypeFilter": "",
  "followerEventTypeFilter": "npc_thoughts",

  "pendingTtlGameMinutes": 720.0,
  "pendingResolveEventInterval": 30,
  "pendingResolveCooldownSeconds": 240.0,

  "ledgerEnabled": true,
  "ledgerSlots": 6,
  "ledgerVeto": true,
  "partyEchoGameDays": 7.0,

  "deferOnConversation": true,
  "quietSeconds": 25.0,
  "conversationSettleSeconds": 100.0,
  "maxDeferSeconds": 60.0,
  "injectQuietGap": true,
  "quietPollSeconds": 1.0,

  "combatEventsEnabled": false,
  "combatEventIntervalSeconds": 15.0,
  "combatContinuousMode": false,
  "continuousExitGraceSeconds": 10.0,
  "debugLog": false,

  // The lenses themselves are not configuration. Which lenses exist, what each
  // is called, which prompt file it asks through and whether it produces
  // proposals all come from the mod, because they describe prompt files that
  // ship beside the DLL. That is what lets an update add a lens, fix one, or
  // retune a cadence without you having to add a row by hand.
  //
  // What you can set is whether the lens is asked at all (`enabled` off is also
  // how you disable one whose prompt needs a mod you don't have), its cadence,
  // and its ledger slot count (0 = use the shared count above). Only the ones
  // you moved are written.
  //
  // There is no shared impulse interval. Each lens waits `intervalGameMinutes`
  // between asks, and takes `cooldownGameMinutes` on top of that once an ask has
  // landed as something she is carrying — whether or not she has said it yet.
  // Both are in-game minutes, so they stretch and compress with the timescale.
  //
  // `weight` and the old top-level `intervalGameMinutes` are gone. A file that
  // still has them is read, they are named in the log, and they are not written
  // back — except `weight: 0`, which still means "never ask this lens".
  "lenses": {
    "aspiration":   { "enabled": true, "intervalGameMinutes": 120.0, "cooldownGameMinutes": 480.0,  "ledgerSlots": 0 },
    "relationship": { "enabled": true, "intervalGameMinutes": 360.0, "cooldownGameMinutes": 1440.0, "ledgerSlots": 0 },
    "activity":     { "enabled": true, "intervalGameMinutes": 240.0, "cooldownGameMinutes": 2880.0, "ledgerSlots": 3 }
  },

  // A lens you wrote yourself has no shipped row behind it, so it is stored
  // whole. `prompt` resolves to
  // Data/SKSE/Plugins/SkyrimNet/prompts/<prompt>.prompt, and that file must
  // {% extends %} agencyengine_impulse_base.prompt. Omitted entirely by default.
  "customLenses": []
}
